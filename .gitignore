# Ignore the Python virtual environment folder
venv_for_parsemouth_project/

# Ignore Python cache files and compiled bytecode
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignore system or editor-specific temporary files
*.DS_Store        # macOS
*.swp             # Vim
*.swo
*.bak

# Ignore log files
*.log

# Ignore Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Ignore VS Code workspace settings (optional)
.vscode/

# Allow tracking requirements.txt explicitly
!requirements.txt

# Ignore output audio and text reports, except requirements.txt
*.wav
*.mp3
*.txt

# But keep the requirements file even though it's .txt
!requirements.txt

# Ignore analysis reports directory
parselmouth_reports/
